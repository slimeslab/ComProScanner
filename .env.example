# Copy this file to a new file named .env and replace the placeholders with your actual keys.

# Publisher API keys
SCOPUS_API_KEY=YOUR_SCOPUS_API_KEY
SPRINGER_OPENACCESS_API_KEY=YOUR_SPRINGER_OPENACCESS_API_KEY
SPRINGER_TDM_API_KEY=YOUR_SPRINGER_TDM_API_KEY/API_METRIC
WILEY_API_KEY=YOUR_WILEY_API_KEY
IOP_papers_path=ABSOLUTE_FOLDERPATH_TO_IOP_PAPERS # IOPScience provides a bulk download of their papers in XML format via SFTP.

# MySQL Database
DATABASE_HOST=DB_HOST
DATABASE_USER=DB_USER_NAME
DATABASE_PASSWORD=DB_PASSWORD
DATABASE_NAME=DB_NAME

# LLM Providers
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
TOGETHER_API_KEY=YOUR_TOGETHER_API_KEY
COHERE_API_KEY=YOUR_COHERE_API_KEY
FIREWORKS_API_KEY=YOUR_FIREWORKS_API_KEY
EQUATION_TOOL_MODEL= # Optional explicit litellm model override for EquationTool (e.g., openai/gpt-4o-mini)

# neo4j
NEO4J_URI=YOUR_NEO4J_URI # default URI for Neo4j is bolt://localhost:7687
NEO4J_USER=YOUR_NEO4J_USERNAME
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD
NEO4J_DATABASE=YOUR_NEO4J_DATABASE_NAME

# Optional model access
HF_TOKEN=YOUR_HUGGINGFACE_TOKEN
