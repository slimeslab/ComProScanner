        "synthesis_data": {
            "method": "mixed oxide method with composite fabrication",
            "precursors": [
                "BaCO3",
                "ZrO2",
                "TiO2",
                "Portland cement powder",
                "epoxy resin",
                "hardener"
            ],
            "steps": [
                "BZT powder was prepared by calcining barium carbonate, zirconium dioxide and titanium dioxide at 1200\u00b0C for 2 h using mixed oxide method.",
                "BZT powder was pressed into disc shape of ~15 mm diameter and thickness of ~1.5 mm at applied pressure of ~85 MPa.",
                "BZT discs were sintered at 1450\u00b0C for 2 h.",
                "BZT discs (dimension ~12 mm and thickness ~1.5 mm) were poled using electric field of 1.5 kV/mm at 50\u00b0C for 30 min in silicone oil chamber.",
                "Poled BZT ceramic was cut using diamond saw in parallel direction along polarization axis using cut and fill method.",
                "Mixtures of Portland cement powder, water (w/c ratio 0.35), epoxy resin and hardener (volume ratio 7.5) were prepared as matrix phase.",
                "Mixture was filled into cut areas of BZT ceramic to create 1-3 connectivity composites with 40, 50, and 60 vol% BZT and 0, 3, 5, and 7 vol% epoxy resin.",
                "Samples were cured in controlled chamber at 60\u00b0C for 5 days at 98% RH."
            ],
